  "description": "Multi-user, OpenAI-compatible AI gateway for Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply lumen-ai-gateway --local",
    "db:migrate:remote": "wrangler d1 migrations apply lumen-ai-gateway --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
